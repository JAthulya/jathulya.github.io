---
layout: null
---

[
  {% assign posts = site.posts | where_exp: "post", "post.draft != true" %}
  {% for post in posts %}
    {
      "title": {{ post.title | jsonify }},
      "url": "{{ post.url | relative_url }}",
      "content": {{ post.content | strip_html | strip_newlines | jsonify }}
    }{% unless forloop.last %},{% endunless %}
  {% endfor %}
]
